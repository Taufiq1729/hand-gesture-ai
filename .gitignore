# pyproject.toml
[tool.poetry]
#content

# poetry
#   According to pypa/poetry#632, it is recommended to include poetry.lock in version control
#   to ensure that the exact same versions of dependencies are used when installing for
#   someone else (possibly on another machine).
poetry.lock

# virtualenv
#   According to pypa/virtualenv#113 (and also pypa/virtualenv#155), it is recommended to
#   include a .venv directory in version control, which can be quickly installed with a
#   simple "python -m venv .venv" command.
.venv/

# PyCharm
#   See https://intellij-support.jetbrains.com/hc/en-us/articles/206544839
.idea/
*.iml

# Jupyter notebook
.ipynb_checkpoints/

# pyenv
#   See https://github.com/pyenv/pyenv/issues/1784#issuecomment-545468959
.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if having platform-specific dependencies or dependencies
#   having no cross-platform support, pipenv may install dependencies that don't work, or not
#   install all needed dependencies.
Pipfile.lock

